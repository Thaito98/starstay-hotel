@model DatPhongKhachSan.Models.ViewModels.BaoCaoViewModel
@{
    ViewData["Title"] = "Báo cáo & thống kê";

    var labels  = Model.ChiTietNgay.Select(x => x.Ngay.Day.ToString()).ToArray();
    var revData = Model.ChiTietNgay.Select(x => (double)x.DoanhThu).ToArray();
    var occData = Model.ChiTietNgay.Select(x => x.TiLeCapDay).ToArray();

    var labelsJson = System.Text.Json.JsonSerializer.Serialize(labels);
    var revJson    = System.Text.Json.JsonSerializer.Serialize(revData);
    var occJson    = System.Text.Json.JsonSerializer.Serialize(occData);
}

@section Styles {
<style>
    .bc-hero {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%);
        border-radius: 16px; padding: 28px 32px;
        color: #fff; margin-bottom: 28px;
        position: relative; overflow: hidden;
    }
    .bc-hero::before {
        content: ''; position: absolute;
        width: 300px; height: 300px; border-radius: 50%;
        background: rgba(255,255,255,.06); top: -80px; right: -60px;
    }
    .bc-hero::after {
        content: ''; position: absolute;
        width: 180px; height: 180px; border-radius: 50%;
        background: rgba(255,255,255,.04); bottom: -60px; right: 120px;
    }
    .bc-hero-title { font-size: 1.5rem; font-weight: 800; margin: 0; }
    .bc-hero-sub   { opacity: .75; font-size: .88rem; margin-top: 4px; }

    .kpi-card {
        background: #fff; border-radius: 14px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        padding: 20px 22px; height: 100%;
        border: 1px solid rgba(0,0,0,.04);
        transition: transform .15s, box-shadow .15s;
    }
    .kpi-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.09); }
    .kpi-icon {
        width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; margin-bottom: 14px;
    }
    .kpi-val { font-size: 1.6rem; font-weight: 800; line-height: 1.1; color: #0f172a; }
    .kpi-lbl { font-size: .76rem; color: #64748b; margin-top: 4px; font-weight: 500; }

    .chart-card {
        background: #fff; border-radius: 14px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border: 1px solid rgba(0,0,0,.04); height: 100%;
    }
    .chart-card .card-header {
        background: transparent; border-bottom: 1px solid #f1f5f9;
        padding: 16px 20px; font-weight: 700; font-size: .88rem; color: #1e293b;
        border-radius: 14px 14px 0 0;
    }
    .chart-card .badge-dot {
        width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 6px;
    }
    .chart-card .card-body { padding: 16px 20px 20px; }

    .filter-card {
        background: #fff; border-radius: 14px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border: 1px solid rgba(0,0,0,.04); padding: 18px 22px;
        margin-bottom: 24px;
    }

    .legend-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; }
    .legend-row + .legend-row { border-top: 1px solid #f8fafc; }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .legend-val { font-weight: 700; font-size: .9rem; color: #1e293b; }

    .detail-table thead th {
        background: linear-gradient(135deg, #1e293b, #334155);
        color: #e2e8f0; font-weight: 600; font-size: .78rem;
        letter-spacing: .03em; padding: 11px 14px; border: 0;
    }
    .detail-table tbody td { padding: 9px 14px; font-size: .84rem; vertical-align: middle; }
    .detail-table tbody tr:hover { background: #f8faff; }
    .detail-table tfoot td {
        background: #f8faff; font-weight: 700; font-size: .84rem;
        padding: 10px 14px; border-top: 2px solid #e2e8f0;
    }
</style>
}

<div class="container-fluid py-4 px-4">

    <!-- Hero header -->
    <div class="bc-hero">
        <div class="position-relative">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <p class="bc-hero-sub mb-1"><i class="fas fa-chart-line me-2"></i>Tổng quan kinh doanh</p>
                    <h1 class="bc-hero-title">Báo cáo tháng @Model.Thang / @Model.Nam</h1>
                </div>
                <a asp-action="ExportExcel" asp-route-thang="@Model.Thang" asp-route-nam="@Model.Nam"
                   class="btn btn-light btn-sm fw-semibold px-4 align-self-center" style="border-radius:8px">
                    <i class="fas fa-file-excel me-2 text-success"></i>Xuất Excel
                </a>
            </div>
        </div>
    </div>

    <!-- Bộ lọc -->
    <div class="filter-card">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label fw-semibold small text-muted mb-1">Tháng</label>
                <select name="thang" class="form-select form-select-sm" style="min-width:110px">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Thang == m ? "selected" : null)">Tháng @m</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label fw-semibold small text-muted mb-1">Năm</label>
                <input type="number" name="nam" class="form-control form-control-sm"
                       value="@Model.Nam" min="2020" max="2099" style="width:90px" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm px-4" style="border-radius:8px">
                    <i class="fas fa-search me-1"></i>Xem báo cáo
                </button>
            </div>
        </form>
    </div>

    <!-- KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff">
                    <i class="fas fa-coins"></i>
                </div>
                <div class="kpi-val text-primary">@Model.TongDoanhThu.ToString("N0")<small class="fs-6 fw-normal"> ₫</small></div>
                <div class="kpi-lbl">Tổng doanh thu</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#10b981,#059669);color:#fff">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="kpi-val text-success">@Model.DoanhThuThuan.ToString("N0")<small class="fs-6 fw-normal"> ₫</small></div>
                <div class="kpi-lbl">Thực thu (sau hoàn tiền)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#06b6d4,#0284c7);color:#fff">
                    <i class="fas fa-percentage"></i>
                </div>
                <div class="kpi-val" style="color:#06b6d4">@Model.TiLeCapDayTrungBinh<small class="fs-6 fw-normal">%</small></div>
                <div class="kpi-lbl">Lấp đầy trung bình</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="kpi-val" style="color:#f59e0b">@(Model.SoDonDaXacNhan + Model.SoDonDangO + Model.SoDonDaTraPhong)</div>
                <div class="kpi-lbl">Đơn thành công</div>
            </div>
        </div>
    </div>

    <!-- Charts row -->
    <div class="row g-3 mb-4">

        <!-- Doanh thu theo ngày -->
        <div class="col-lg-8">
            <div class="chart-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        <span class="badge-dot" style="background:#6366f1"></span>
                        Doanh thu theo ngày (₫)
                    </span>
                    <span class="text-muted small fw-normal">Tháng @Model.Thang / @Model.Nam</span>
                </div>
                <div class="card-body">
                    <canvas id="chartRevenue" style="height:240px;max-height:240px"></canvas>
                </div>
            </div>
        </div>

        <!-- Phân tích đơn -->
        <div class="col-lg-4">
            <div class="chart-card">
                <div class="card-header">
                    <span class="badge-dot" style="background:#10b981"></span>
                    Phân tích đơn đặt phòng
                </div>
                <div class="card-body d-flex flex-column">
                    <div>
                        <canvas id="chartDon" style="height:160px;max-height:160px"></canvas>
                    </div>
                    <div class="mt-3">
                        <div class="legend-row">
                            <span class="d-flex align-items-center gap-2">
                                <span class="legend-dot" style="background:#6366f1"></span>
                                <span class="small">Đã xác nhận</span>
                            </span>
                            <span class="legend-val">@Model.SoDonDaXacNhan</span>
                        </div>
                        <div class="legend-row">
                            <span class="d-flex align-items-center gap-2">
                                <span class="legend-dot" style="background:#10b981"></span>
                                <span class="small">Đang ở</span>
                            </span>
                            <span class="legend-val">@Model.SoDonDangO</span>
                        </div>
                        <div class="legend-row">
                            <span class="d-flex align-items-center gap-2">
                                <span class="legend-dot" style="background:#94a3b8"></span>
                                <span class="small">Đã trả phòng</span>
                            </span>
                            <span class="legend-val">@Model.SoDonDaTraPhong</span>
                        </div>
                        <div class="legend-row">
                            <span class="d-flex align-items-center gap-2">
                                <span class="legend-dot" style="background:#ef4444"></span>
                                <span class="small">Hủy / Hoàn</span>
                            </span>
                            <span class="legend-val">@Model.SoDonDaHuy</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tỷ lệ lấp đầy -->
        <div class="col-12">
            <div class="chart-card">
                <div class="card-header">
                    <span class="badge-dot" style="background:#06b6d4"></span>
                    Tỷ lệ lấp đầy phòng theo ngày (%)
                </div>
                <div class="card-body">
                    <canvas id="chartOcc" style="height:120px;max-height:120px"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chi tiết từng ngày -->
    <div class="chart-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><span class="badge-dot" style="background:#f59e0b"></span>Chi tiết từng ngày</span>
            <span class="badge bg-primary bg-opacity-10 text-primary small fw-normal">@Model.ChiTietNgay.Count() ngày</span>
        </div>

        <!-- ── Mobile cards ──────────────────────────────────── -->
        <div class="d-md-none p-2 d-flex flex-column gap-2">
            @foreach (var item in Model.ChiTietNgay)
            {
                var pctMb     = item.TiLeCapDay;
                var barClsMb  = pctMb >= 80 ? "bg-success" : pctMb >= 50 ? "bg-warning" : "bg-secondary";
                var textClsMb = pctMb >= 80 ? "text-success" : pctMb >= 50 ? "text-warning" : "text-secondary";
                <div class="card border rounded-3 @(item.DoanhThu == 0 ? "border-0 bg-light" : "shadow-sm")">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small" style="color:#1e293b">@item.Ngay.ToString("dd/MM/yyyy (ddd)")</span>
                            <span class="badge bg-light text-dark border" style="font-size:.72rem">@item.PhongBan/@Model.TongSoPhong phòng</span>
                        </div>
                        <div class="row g-2 small mb-2">
                            <div class="col-4">
                                <div class="text-muted" style="font-size:.7rem">Doanh thu</div>
                                <div class="fw-semibold text-primary">@(item.DoanhThu > 0 ? item.DoanhThu.ToString("N0") : "-")</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size:.7rem">Hoàn tiền</div>
                                <div class="@(item.HoanTien > 0 ? "text-danger fw-semibold" : "text-muted")">@(item.HoanTien > 0 ? "−" + item.HoanTien.ToString("N0") : "-")</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted" style="font-size:.7rem">Thực thu</div>
                                <div class="fw-semibold text-success">@((item.DoanhThu - item.HoanTien).ToString("N0"))</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="progress flex-grow-1" style="height:6px;border-radius:99px">
                                <div class="progress-bar @barClsMb" style="width:@pctMb%;border-radius:99px"></div>
                            </div>
                            <span class="small fw-semibold @textClsMb" style="min-width:36px;text-align:right">@pctMb%</span>
                        </div>
                    </div>
                </div>
            }
            <!-- Tổng -->
            <div class="card border-2 border-primary rounded-3">
                <div class="card-body p-3 small">
                    <div class="fw-bold mb-1">Tổng tháng @Model.Thang/@Model.Nam</div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Doanh thu:</span>
                        <span class="fw-semibold text-primary">@Model.TongDoanhThu.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Hoàn tiền:</span>
                        <span class="text-danger">−@Model.TongHoanTien.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-1 mt-1">
                        <span class="fw-semibold">Thực thu:</span>
                        <span class="fw-bold text-success">@Model.DoanhThuThuan.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted">Lấp đầy TB:</span>
                        <span class="fw-semibold">@Model.TiLeCapDayTrungBinh%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Desktop table ──────────────────────────────────── -->
        <div class="table-responsive d-none d-md-block">
            <table class="table detail-table mb-0">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th class="text-end">Doanh thu</th>
                        <th class="text-end">Hoàn tiền</th>
                        <th class="text-end">Thực thu</th>
                        <th class="text-center">Phòng có khách</th>
                        <th class="text-center" style="min-width:160px">Lấp đầy</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ChiTietNgay)
                    {
                        <tr class="@(item.DoanhThu == 0 ? "text-muted" : "")">
                            <td class="fw-semibold" style="color:#1e293b">@item.Ngay.ToString("dd/MM/yyyy (ddd)")</td>
                            <td class="text-end @(item.DoanhThu > 0 ? "fw-semibold text-primary" : "")">
                                @(item.DoanhThu > 0 ? item.DoanhThu.ToString("N0") + " ₫" : "-")
                            </td>
                            <td class="text-end @(item.HoanTien > 0 ? "text-danger" : "")">
                                @(item.HoanTien > 0 ? "−" + item.HoanTien.ToString("N0") + " ₫" : "-")
                            </td>
                            <td class="text-end text-success fw-semibold">
                                @((item.DoanhThu - item.HoanTien).ToString("N0")) ₫
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border" style="font-size:.78rem">
                                    @item.PhongBan / @Model.TongSoPhong
                                </span>
                            </td>
                            <td class="text-center">
                                @{
                                    var pct = item.TiLeCapDay;
                                    var barCls   = pct >= 80 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-secondary";
                                    var textCls  = pct >= 80 ? "text-success" : pct >= 50 ? "text-warning" : "text-secondary";
                                }
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:7px;border-radius:99px">
                                        <div class="progress-bar @barCls" style="width:@pct%;border-radius:99px"></div>
                                    </div>
                                    <span class="small fw-semibold @textCls" style="min-width:38px;text-align:right">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="text-muted small">Tổng / Trung bình</td>
                        <td class="text-end text-primary">@Model.TongDoanhThu.ToString("N0") ₫</td>
                        <td class="text-end text-danger">−@Model.TongHoanTien.ToString("N0") ₫</td>
                        <td class="text-end text-success">@Model.DoanhThuThuan.ToString("N0") ₫</td>
                        <td class="text-center">-</td>
                        <td class="text-center text-muted">@Model.TiLeCapDayTrungBinh%</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const labels  = @Html.Raw(labelsJson);
    const revData = @Html.Raw(revJson);
    const occData = @Html.Raw(occJson);

    const fmtVND = v => {
        if (v >= 1_000_000) return (v / 1_000_000).toLocaleString('vi-VN', {maximumFractionDigits:1}) + ' tr';
        if (v >= 1_000)     return (v / 1_000).toFixed(0) + 'k';
        return v.toLocaleString('vi-VN');
    };

    // Bar chart - doanh thu
    new Chart(document.getElementById('chartRevenue'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Doanh thu',
                data: revData,
                backgroundColor: 'rgba(99,102,241,.75)',
                borderColor: '#6366f1',
                borderWidth: 0,
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: { label: ctx => ' ' + ctx.raw.toLocaleString('vi-VN') + ' ₫' }
                }
            },
            scales: {
                y: {
                    grid: { color: 'rgba(0,0,0,.04)' },
                    ticks: { callback: fmtVND, font: { size: 11 } }
                },
                x: { grid: { display: false }, ticks: { font: { size: 11 } } }
            }
        }
    });

    // Doughnut - đơn
    new Chart(document.getElementById('chartDon'), {
        type: 'doughnut',
        data: {
            labels: ['Đã xác nhận','Đang ở','Đã trả','Hủy/Hoàn'],
            datasets: [{
                data: [@Model.SoDonDaXacNhan, @Model.SoDonDangO, @Model.SoDonDaTraPhong, @Model.SoDonDaHuy],
                backgroundColor: ['#6366f1','#10b981','#94a3b8','#ef4444'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: { legend: { display: false } }
        }
    });

    // Line - lấp đầy
    new Chart(document.getElementById('chartOcc'), {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Lấp đầy (%)',
                data: occData,
                borderColor: '#06b6d4',
                backgroundColor: 'rgba(6,182,212,.12)',
                fill: true, tension: 0.35, pointRadius: 3,
                pointBackgroundColor: '#06b6d4', borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    min: 0, max: 100,
                    grid: { color: 'rgba(0,0,0,.04)' },
                    ticks: { callback: v => v + '%', font: { size: 11 } }
                },
                x: { grid: { display: false }, ticks: { font: { size: 11 } } }
            }
        }
    });
</script>
}
