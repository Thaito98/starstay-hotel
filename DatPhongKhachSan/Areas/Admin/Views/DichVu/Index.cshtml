@model List<DatPhongKhachSan.Models.Entities.DichVu>
@{ ViewData["Title"] = "Quản lý dịch vụ"; }

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="fw-bold mb-0"><i class="fas fa-spa me-2 text-primary"></i>Dịch vụ</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Thêm dịch vụ</a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <!-- ── Mobile cards ──────────────────────────────────── -->
            <div class="d-md-none p-2 d-flex flex-column gap-2">
                @foreach (var d in Model)
                {
                    <div class="card border rounded-3 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                                     style="width:44px;height:44px;flex-shrink:0;font-size:1.2rem;background:linear-gradient(135deg,#06b6d4,#0891b2);">
                                    <i class="fas fa-spa"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@d.TenDichVu</div>
                                    <div class="text-primary fw-bold">@d.Gia.ToString("N0") ₫<small class="text-muted fw-normal"> / @d.DonVi</small></div>
                                    <form asp-action="DoiTrangThai" asp-route-id="@d.MaDichVu" method="post" class="d-inline mt-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(d.TrangThai ? "btn-success" : "btn-outline-secondary") mt-1" style="font-size:.75rem;padding:.2rem .6rem;">
                                            @(d.TrangThai ? "Kích hoạt" : "Ẩn")
                                        </button>
                                    </form>
                                </div>
                                <div class="d-flex flex-column gap-1" style="flex-shrink:0;">
                                    <a asp-action="Edit" asp-route-id="@d.MaDichVu" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@d.MaDichVu" method="post"
                                          data-confirm="Xóa dịch vụ '@d.TenDichVu'?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.Any()) { <div class="text-center text-muted py-4 small">Chưa có dịch vụ nào.</div> }
            </div>

            <!-- ── Desktop table ──────────────────────────────────── -->
            <div class="table-responsive d-none d-md-block">
            <table id="tbl" class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Tên dịch vụ</th><th>Giá</th><th>Đơn vị</th><th>Kích hoạt</th><th></th></tr></thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@d.TenDichVu</td>
                            <td>@d.Gia.ToString("N0") ₫</td>
                            <td class="text-muted">@d.DonVi</td>
                            <td>
                                <form asp-action="DoiTrangThai" asp-route-id="@d.MaDichVu" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(d.TrangThai ? "btn-success" : "btn-outline-secondary")">
                                        @(d.TrangThai ? "Kích hoạt" : "Ẩn")
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@d.MaDichVu" class="btn btn-outline-primary btn-sm me-1"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@d.MaDichVu" method="post" class="d-inline"
                                      data-confirm="Xóa dịch vụ '@d.TenDichVu'?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#tbl').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json' } });
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title:'Xác nhận', text:f.dataset.confirm, icon:'warning', showCancelButton:true,
                    confirmButtonText:'Xóa', cancelButtonText:'Hủy', confirmButtonColor:'#dc3545'
                }).then(r => { if(r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
