@model DatPhongKhachSan.Models.Entities.DatPhong
@{
    ViewData["Title"] = $"Đơn {Model.MaDon}";
    var tien = ViewBag.TinhTien as DatPhongKhachSan.Services.TinhTienResult;
    var trangThaiText = Model.TrangThai switch
    {
        "ChoXacNhan"  => ("Chờ xác nhận",   "warning"),
        "DaXacNhan"   => ("Đã xác nhận",    "primary"),
        "DangO"       => ("Đang ở",         "success"),
        "DaTraPhong"  => ("Đã trả phòng",   "secondary"),
        "ChoHoanTien" => ("Chờ hoàn tiền",  "info"),
        "DaHuy"       => ("Đã hủy",         "danger"),
        _ => (Model.TrangThai, "secondary")
    };
}

<div class="container py-4" style="max-width:900px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index">Tất cả đơn</a></li>
                <li class="breadcrumb-item active">@Model.MaDon</li>
            </ol>
        </nav>
        <span class="badge bg-@trangThaiText.Item2 fs-6">@trangThaiText.Item1</span>
    </div>

    <div class="row g-3">
        <!-- Thông tin đơn + khách -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-semibold"><i class="fas fa-file-alt me-1 text-primary"></i>Thông tin đơn</div>
                <div class="card-body small">
                    <div class="row g-1">
                        <div class="col-5 text-muted">Mã đơn</div><div class="col-7 fw-bold">@Model.MaDon</div>
                        <div class="col-5 text-muted">Nguồn</div><div class="col-7"><span class="badge @(Model.NguonDat=="WalkIn"?"bg-info":"bg-primary")">@Model.NguonDat</span></div>
                        <div class="col-5 text-muted">Ngày đặt</div><div class="col-7">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-5 text-muted">Nhận phòng</div><div class="col-7 fw-semibold text-success">@Model.NgayNhanPhong.ToString("dd/MM/yyyy")</div>
                        <div class="col-5 text-muted">Trả phòng</div><div class="col-7 fw-semibold text-danger">@Model.NgayTraPhong.ToString("dd/MM/yyyy") (@Model.SoDem đêm)</div>
                        <div class="col-5 text-muted">Số người</div><div class="col-7">@Model.TongSoNguoiLon NL@(Model.TongSoTreEm>0?$", {Model.TongSoTreEm} TE":"")</div>
                        <div class="col-5 text-muted">Thanh toán</div><div class="col-7">@Model.LoaiThanhToan</div>
                        @if (!string.IsNullOrEmpty(Model.GhiChu)) { <div class="col-5 text-muted">Ghi chú</div><div class="col-7 text-muted" style="white-space:pre-wrap;">@Model.GhiChu</div> }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-semibold"><i class="fas fa-user me-1 text-primary"></i>Khách hàng</div>
                <div class="card-body small">
                    <div class="row g-1">
                        <div class="col-5 text-muted">Họ tên</div><div class="col-7 fw-semibold">@Model.MaNguoiDungNavigation?.HoTen</div>
                        <div class="col-5 text-muted">SĐT</div><div class="col-7">@(Model.MaNguoiDungNavigation?.SoDienThoai ?? "-")</div>
                        <div class="col-5 text-muted">Email</div><div class="col-7">@(Model.MaNguoiDungNavigation?.Email ?? "-")</div>
                        <div class="col-5 text-muted">CCCD</div><div class="col-7">@(Model.MaNguoiDungNavigation?.CCCD ?? "-")</div>
                        <div class="col-5 text-muted">Phân loại</div><div class="col-7">@Model.MaNguoiDungNavigation?.PhanLoai</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết phòng -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-semibold"><i class="fas fa-bed me-1 text-primary"></i>Chi tiết</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Phòng</th><th>Loại phòng</th><th>Khách</th><th class="text-end">Giá/đêm</th><th class="text-end">Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTietDatPhongs)
                            {
                                <tr>
                                    <td><b>@ct.MaPhongNavigation?.SoPhong</b></td>
                                    <td>@ct.MaPhongNavigation?.MaLoaiPhongNavigation?.TenLoaiPhong</td>
                                    <td>@ct.TenKhachLuuTru</td>
                                    <td class="text-end">@ct.GiaMotDem.ToString("N0") ₫</td>
                                    <td class="text-end">@((ct.GiaMotDem*(Model.SoDem??0)).ToString("N0")) ₫</td>
                                </tr>
                                @foreach (var dv in ct.ChiTietDichVus)
                                {
                                    <tr class="table-light small text-muted">
                                        <td colspan="2" class="ps-4"><i class="fas fa-concierge-bell me-1"></i>@dv.MaDichVuNavigation?.TenDichVu</td>
                                        <td>×@dv.SoLuong</td>
                                        <td class="text-end">@dv.DonGia.ToString("N0") ₫</td>
                                        <td class="text-end">@((dv.ThanhTien??0).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr><td colspan="4" class="text-end">Tổng cộng</td><td class="text-end text-primary">@tien?.TongTien.ToString("N0") ₫</td></tr>
                            <tr class="text-success"><td colspan="4" class="text-end">Đã thanh toán</td><td class="text-end">@tien?.SoTienDaTra.ToString("N0") ₫</td></tr>
                            @if (tien?.SoTienConLai > 0) {
                                <tr class="text-warning"><td colspan="4" class="text-end">Còn lại</td><td class="text-end">@tien.SoTienConLai.ToString("N0") ₫</td></tr>
                            }
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Lịch sử thanh toán -->
        @if (Model.ThanhToans.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light fw-semibold"><i class="fas fa-receipt me-1 text-primary"></i>Thanh toán</div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light"><tr><th>Loại</th><th>Phương thức</th><th>Mã GD</th><th>Trạng thái</th><th class="text-end">Số tiền</th><th>Ngày</th></tr></thead>
                            <tbody>
                                @foreach (var tt in Model.ThanhToans.OrderBy(t => t.NgayTao))
                                {
                                    <tr>
                                        <td>@tt.LoaiThanhToan</td><td>@tt.PhuongThuc</td>
                                        <td class="text-muted small">@(tt.MaGiaoDich ?? "-")</td>
                                        <td><span class="badge bg-@(tt.TrangThai=="ThanhCong"?"success":tt.TrangThai=="ThatBai"?"danger":"warning")">@tt.TrangThai</span></td>
                                        <td class="text-end fw-semibold">@tt.SoTien.ToString("N0") ₫</td>
                                        <td class="small text-muted">@tt.NgayTao.ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Thông tin hoàn tiền -->
    @if ((Model.TrangThai == "ChoHoanTien" || Model.TrangThai == "DaHuy") && ViewBag.TiLeHoan != null)
    {
        int tileHoan    = (int)ViewBag.TiLeHoan;
        decimal soTienH = (decimal)ViewBag.SoTienHoan;
        string alertCls = tileHoan == 100 ? "success" : tileHoan == 50 ? "warning" : "secondary";
        <div class="col-12 mt-1">
            <div class="alert alert-@alertCls d-flex align-items-center gap-2 mb-0">
                <i class="fas fa-undo-alt"></i>
                <div>
                    <span class="fw-semibold">Chính sách hoàn tiền:</span>
                    hoàn <b>@tileHoan%</b>
                    @if (tileHoan > 0)
                    {
                        <span> = <b>@soTienH.ToString("N0") ₫</b></span>
                    }
                    else
                    {
                        <span class="text-muted"> (hủy sát ngày nhận phòng - không hoàn)</span>
                    }
                    @if (Model.NgayHuy.HasValue)
                    {
                        <span class="text-muted ms-2 small">(hủy lúc @Model.NgayHuy.Value.ToString("dd/MM/yyyy HH:mm"))</span>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Nút thao tác Admin -->
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>

        @if (Model.TrangThai == "ChoXacNhan")
        {
            <form asp-action="XacNhan" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i>Xác nhận đơn</button>
            </form>
        }
        @if (Model.TrangThai is "ChoXacNhan" or "DaXacNhan")
        {
            <form asp-action="Huy" method="post" class="d-inline"
                  data-confirm="Hủy đơn @Model.MaDon?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                <button type="submit" class="btn btn-outline-danger"><i class="fas fa-times me-1"></i>Hủy đơn</button>
            </form>
        }
        @if (Model.TrangThai == "ChoHoanTien")
        {
            <form asp-action="DaHoanTien" method="post" class="d-inline"
                  data-confirm="Xác nhận đã hoàn tiền ngoài app ngân hàng cho đơn @Model.MaDon?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDatPhong" value="@Model.MaDatPhong" />
                <button type="submit" class="btn btn-success"><i class="fas fa-check-double me-1"></i>Đã hoàn tiền</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title: 'Xác nhận', text: f.dataset.confirm, icon: 'warning',
                    showCancelButton: true, confirmButtonText: 'Đồng ý', cancelButtonText: 'Hủy',
                    confirmButtonColor: '#dc3545'
                }).then(r => { if (r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
