@model DatPhongKhachSan.Models.ViewModels.AdminDashboardVm
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-3 px-lg-4 py-3">

    <!-- Tiêu đề -->
    <div class="mb-3">
        <h5 class="fw-bold text-dark mb-0">
            <i class="fas fa-gauge-high me-2 text-primary"></i>Dashboard
        </h5>
        <small class="text-muted">
            Tổng quan hôm nay - @DateTime.Today.ToString("dddd, dd/MM/yyyy")
        </small>
    </div>

    <!-- Stat cards: 1 cột mobile => 2 cột sm => 3 cột md => 5 cột xl -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">

        <!-- Check-in -->
        <div class="col">
            <div class="stat-card h-100">
                <div class="stat-icon" style="background:#eff6ff;color:#2563eb;">
                    <i class="fas fa-sign-in-alt"></i>
                </div>
                <div>
                    <div class="stat-val" style="color:#2563eb;">@Model.CheckInHomNay</div>
                    <div class="stat-lbl">Check-in hôm nay</div>
                </div>
            </div>
        </div>

        <!-- Check-out -->
        <div class="col">
            <div class="stat-card h-100">
                <div class="stat-icon" style="background:#fffbeb;color:#d97706;">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <div>
                    <div class="stat-val" style="color:#d97706;">@Model.CheckOutHomNay</div>
                    <div class="stat-lbl">Check-out hôm nay</div>
                </div>
            </div>
        </div>

        <!-- Phòng trống -->
        <div class="col">
            <div class="stat-card h-100">
                <div class="stat-icon" style="background:#f0fdf4;color:#16a34a;">
                    <i class="fas fa-door-open"></i>
                </div>
                <div>
                    <div class="stat-val" style="color:#16a34a;">@Model.PhongTrong</div>
                    <div class="stat-lbl">Phòng trống</div>
                </div>
            </div>
        </div>

        <!-- Đơn chờ xác nhận -->
        <div class="col">
            <div class="stat-card h-100">
                <div class="stat-icon" style="background:#fff7ed;color:#ea580c;">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <div class="stat-val" style="color:#ea580c;">@Model.DonChoXacNhan</div>
                    <div class="stat-lbl">Đơn chờ xác nhận</div>
                </div>
            </div>
        </div>

        <!-- Doanh thu hôm nay -->
        <div class="col">
            <div class="stat-card h-100">
                <div class="stat-icon" style="background:#faf5ff;color:#9333ea;">
                    <i class="fas fa-money-bill-wave"></i>
                </div>
                <div>
                    <div class="stat-val" style="color:#9333ea;font-size:1.1rem;">
                        @Model.DoanhThuHomNay.ToString("N0") ₫
                    </div>
                    <div class="stat-lbl">Doanh thu hôm nay</div>
                </div>
            </div>
        </div>

    </div>

    <!-- Biểu đồ doanh thu 7 ngày -->
    <div class="admin-card p-3 p-lg-4">
        <h6 class="fw-semibold mb-3">
            <i class="fas fa-chart-line me-2 text-primary"></i>Doanh thu 7 ngày gần nhất
        </h6>
        <div style="position:relative;height:260px;">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function () {
    var labels = @Html.Raw(ViewBag.ChartLabels);
    var data   = @Html.Raw(ViewBag.ChartData);

    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: data,
                backgroundColor: 'rgba(59,130,246,.12)',
                borderColor:     'rgba(59,130,246,.75)',
                borderWidth: 2,
                borderRadius: 5,
                hoverBackgroundColor: 'rgba(59,130,246,.22)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(ctx) {
                            return ' ' + Number(ctx.raw).toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,.05)' },
                    ticks: {
                        callback: function(val) {
                            if (val >= 1000000) return (val / 1000000).toFixed(0) + 'M';
                            if (val >= 1000)    return (val / 1000).toFixed(0) + 'K';
                            return val;
                        }
                    }
                },
                x: { grid: { display: false } }
            }
        }
    });
}());
</script>
}
