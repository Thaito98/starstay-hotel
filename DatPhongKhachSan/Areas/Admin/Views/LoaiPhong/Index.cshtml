@model List<DatPhongKhachSan.Models.Entities.LoaiPhong>
@{
    ViewData["Title"] = "Quản lý loại phòng";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="fw-bold mb-0"><i class="fas fa-bed me-2 text-primary"></i>Loại phòng</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Thêm loại phòng</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <!-- ── Mobile cards (< 768px) ─────────────────────────── -->
            <div class="d-md-none p-2 d-flex flex-column gap-2">
                @foreach (var lp in Model)
                {
                    var anhChinh = lp.AnhPhongs.FirstOrDefault(a => a.LaAnhChinh) ?? lp.AnhPhongs.FirstOrDefault();
                    <div class="card border rounded-3 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex gap-3 align-items-start">
                                <!-- Ảnh -->
                                <div style="flex-shrink:0;">
                                    @if (anhChinh != null)
                                    {
                                        <img src="@anhChinh.DuongDanAnh" class="rounded-2" style="width:72px;height:58px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary bg-opacity-10 rounded-2 d-flex align-items-center justify-content-center" style="width:72px;height:58px;">
                                            <i class="fas fa-image text-secondary fs-5"></i>
                                        </div>
                                    }
                                </div>
                                <!-- Thông tin -->
                                <div class="flex-grow-1" style="min-width:0;">
                                    <div class="fw-semibold text-truncate">@lp.TenLoaiPhong</div>
                                    <div class="text-primary fw-bold">@lp.GiaCoBan.ToString("N0") ₫<small class="text-muted fw-normal">/đêm</small></div>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        <span class="badge bg-light text-dark border" style="font-size:.7rem;">@lp.SucChuaNguoiLon NL, @lp.SucChuaTreEm TE</span>
                                        <span class="badge bg-info text-white" style="font-size:.7rem;">@lp.Phongs.Count phòng</span>
                                        <span class="badge bg-light text-dark border" style="font-size:.7rem;">@lp.MaTienNghis.Count tiện nghi</span>
                                        <span class="badge @(lp.TrangThai ? "bg-success" : "bg-secondary")" style="font-size:.7rem;">@(lp.TrangThai ? "Kích hoạt" : "Ẩn")</span>
                                    </div>
                                </div>
                                <!-- Nút -->
                                <div class="d-flex flex-column gap-1" style="flex-shrink:0;">
                                    <a asp-action="Edit" asp-route-id="@lp.MaLoaiPhong" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@lp.MaLoaiPhong" method="post"
                                          data-confirm="Xóa loại phòng '@lp.TenLoaiPhong'?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.Any()) { <div class="text-center text-muted py-4 small">Chưa có dữ liệu.</div> }
            </div>

            <!-- ── Desktop table (>= 768px) ───────────────────────── -->
            <div class="table-responsive d-none d-md-block">
            <table id="tbl" class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Ảnh</th><th>Tên loại phòng</th><th>Giá/đêm</th>
                        <th>Sức chứa</th><th>Phòng</th><th>Tiện nghi</th><th>Kích hoạt</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lp in Model)
                    {
                        var anhChinh = lp.AnhPhongs.FirstOrDefault(a => a.LaAnhChinh) ?? lp.AnhPhongs.FirstOrDefault();
                        <tr>
                            <td style="width:60px;">
                                @if (anhChinh != null)
                                {
                                    <img src="@anhChinh.DuongDanAnh" class="rounded" style="width:50px;height:40px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center" style="width:50px;height:40px;">
                                        <i class="fas fa-image text-secondary" style="font-size:14px;"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@lp.TenLoaiPhong</td>
                            <td>@lp.GiaCoBan.ToString("N0") ₫</td>
                            <td>@lp.SucChuaNguoiLon NL, @lp.SucChuaTreEm TE</td>
                            <td><span class="badge bg-info">@lp.Phongs.Count phòng</span></td>
                            <td><span class="badge bg-light text-dark border">@lp.MaTienNghis.Count tiện nghi</span></td>
                            <td>
                                <span class="badge @(lp.TrangThai ? "bg-success" : "bg-secondary")">
                                    @(lp.TrangThai ? "Kích hoạt" : "Ẩn")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@lp.MaLoaiPhong" class="btn btn-outline-primary btn-sm me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@lp.MaLoaiPhong" method="post" class="d-inline" data-confirm="Xóa loại phòng '@lp.TenLoaiPhong'?">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#tbl').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json' } });
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title: 'Xác nhận xóa', text: f.dataset.confirm, icon: 'warning',
                    showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy',
                    confirmButtonColor: '#dc3545' })
                .then(r => { if (r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
