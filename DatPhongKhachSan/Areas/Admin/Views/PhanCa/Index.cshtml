@model DatPhongKhachSan.Models.ViewModels.LichCaViewModel
@{
    ViewData["Title"] = "Xếp ca làm việc";
    var prevWeek = Model.TuNgay.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.TuNgay.AddDays(7).ToString("yyyy-MM-dd");
    var thuViet  = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
}

<div class="container-fluid py-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-calendar-alt me-2 text-primary"></i>Xếp ca làm việc</h2>

    <div class="row g-4">
        <!-- Lịch ca -->
        <div class="col-xl-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <a asp-action="Index" asp-route-tuNgay="@prevWeek" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                    <span class="fw-semibold">
                        @Model.TuNgay.ToString("dd/MM") - @Model.DenNgay.ToString("dd/MM/yyyy")
                    </span>
                    <a asp-action="Index" asp-route-tuNgay="@nextWeek" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </div>
                <!-- ── Mobile: danh sách theo nhân viên ──────────────────────── -->
                <div class="d-md-none p-2 d-flex flex-column gap-2">
                    @foreach (var nv in Model.NhanViens)
                    {
                        var caNv = Model.TatCaPhanCa.Where(p => p.MaNguoiDung == nv.MaNguoiDung).ToList();
                        <div class="card border rounded-3 shadow-sm">
                            <div class="card-body p-3">
                                <div class="fw-semibold mb-2">@nv.HoTen</div>
                                @if (!caNv.Any())
                                {
                                    <div class="text-muted small fst-italic">Chưa có ca tuần này</div>
                                }
                                else
                                {
                                    @foreach (var ngay in Model.Ngays)
                                    {
                                        var cacCa = caNv.Where(p => p.NgayLam == ngay).ToList();
                                        if (cacCa.Any())
                                        {
                                            var isToday = ngay == DateOnly.FromDateTime(DateTime.Today);
                                            <div class="d-flex align-items-start gap-2 mb-1">
                                                <span class="badge @(isToday ? "bg-warning text-dark" : "bg-secondary") mt-1" style="min-width:42px;font-size:.68rem;">
                                                    @thuViet[(int)ngay.DayOfWeek] @ngay.Day
                                                </span>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var pc in cacCa)
                                                    {
                                                        <div class="d-flex align-items-center gap-1 badge bg-primary text-white px-2 py-1" style="font-size:.72rem;border-radius:6px;">
                                                            <span>@pc.MaCaNavigation?.TenCa</span>
                                                            <form asp-action="XoaPhanCa" method="post" class="d-inline"
                                                                  data-confirm="Xóa ca này?">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="maNguoiDung" value="@pc.MaNguoiDung" />
                                                                <input type="hidden" name="ngayLam" value="@pc.NgayLam.ToString("yyyy-MM-dd")" />
                                                                <input type="hidden" name="maCa" value="@pc.MaCa" />
                                                                <input type="hidden" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" />
                                                                <button type="submit" class="btn btn-link p-0 text-white" style="font-size:10px;" title="Xóa">Xóa</button>
                                                            </form>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- ── Desktop: bảng lịch 7 ngày ──────────────────────────────── -->
                <div class="card-body p-0 table-responsive d-none d-md-block">
                    <table class="table table-bordered table-sm mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th style="min-width:130px;">Nhân viên</th>
                                @foreach (var ngay in Model.Ngays)
                                {
                                    var isToday = ngay == DateOnly.FromDateTime(DateTime.Today);
                                    <th class="text-center @(isToday ? "table-warning" : "")"
                                        style="min-width:100px;">
                                        @thuViet[(int)ngay.DayOfWeek]<br />
                                        <small>@ngay.ToString("dd/MM")</small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var nv in Model.NhanViens)
                            {
                                <tr>
                                    <td class="fw-semibold small">@nv.HoTen</td>
                                    @foreach (var ngay in Model.Ngays)
                                    {
                                        var cacCaHomNay = Model.TatCaPhanCa
                                            .Where(p => p.MaNguoiDung == nv.MaNguoiDung && p.NgayLam == ngay)
                                            .ToList();
                                        <td class="text-center p-1" style="min-height:60px;">
                                            @foreach (var pc in cacCaHomNay)
                                            {
                                                <div class="d-flex align-items-center justify-content-between
                                                            badge bg-primary text-white mb-1 px-2 py-1"
                                                     style="font-size:11px; border-radius:6px;">
                                                    <span>@pc.MaCaNavigation?.TenCa</span>
                                                    <form asp-action="XoaPhanCa" method="post" class="d-inline ms-1"
                                                          data-confirm="Xóa ca này?">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="maNguoiDung" value="@pc.MaNguoiDung" />
                                                        <input type="hidden" name="ngayLam" value="@pc.NgayLam.ToString("yyyy-MM-dd")" />
                                                        <input type="hidden" name="maCa" value="@pc.MaCa" />
                                                        <input type="hidden" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" />
                                                        <button type="submit" class="btn btn-link p-0 text-white"
                                                                style="font-size:10px;" title="Xóa">
                                                            Xóa
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Form gán ca -->
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-plus-circle me-1 text-success"></i>Gán ca mới
                </div>
                <div class="card-body">
                    <form asp-action="GanCa" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" />
                        <div class="col-12 col-md-3">
                            <label class="form-label fw-semibold small">Nhân viên</label>
                            <select name="maNguoiDung" class="form-select form-select-sm">
                                @foreach (var nv in Model.NhanViens)
                                {
                                    <option value="@nv.MaNguoiDung">@nv.HoTen</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">Ngày làm</label>
                            <input type="date" name="ngayLam" class="form-control form-control-sm"
                                   value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                                   min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                                   title="Chỉ được gán ca từ hôm nay trở đi" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label fw-semibold small">Ca làm việc</label>
                            <select name="maCa" class="form-select form-select-sm">
                                @foreach (var ca in Model.CacCa)
                                {
                                    <option value="@ca.MaCa">
                                        @ca.TenCa (@ca.GioBatDau.ToString("HH:mm")-@ca.GioKetThuc.ToString("HH:mm"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-9 col-md-2">
                            <label class="form-label fw-semibold small">Ghi chú</label>
                            <input name="ghiChu" class="form-control form-control-sm" placeholder="Tuỳ chọn" />
                        </div>
                        <div class="col-3 col-md-1">
                            <button type="submit" class="btn btn-success btn-sm w-100">Gán</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Quản lý Ca làm việc -->
        <div class="col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-clock me-1 text-primary"></i>Danh mục ca
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Tên ca</th><th>Giờ</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in Model.CacCa)
                            {
                                <tr>
                                    <td class="small fw-semibold">@ca.TenCa</td>
                                    <td class="small text-muted">
                                        @ca.GioBatDau.ToString("HH:mm")-@ca.GioKetThuc.ToString("HH:mm")
                                    </td>
                                    <td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form asp-action="XoaCa" method="post" class="d-inline"
                                                  data-confirm="Xóa ca @ca.TenCa?">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maCa" value="@ca.MaCa" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        title="Xóa">
                                                    <i class="fas fa-trash" style="font-size:11px;"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="card-footer bg-white">
                        <form asp-action="TaoCa" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <input name="tenCa" class="form-control form-control-sm"
                                       placeholder="Tên ca (vd: Ca sáng)" required />
                            </div>
                            <div class="row g-1 mb-2">
                                <div class="col-6">
                                    <input name="gioBatDau" type="time" class="form-control form-control-sm"
                                           placeholder="Bắt đầu" required />
                                </div>
                                <div class="col-6">
                                    <input name="gioKetThuc" type="time" class="form-control form-control-sm"
                                           placeholder="Kết thúc" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="fas fa-plus me-1"></i>Thêm ca
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title: 'Xác nhận', text: f.dataset.confirm, icon: 'warning',
                    showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy',
                    confirmButtonColor: '#dc3545'
                }).then(r => { if (r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
