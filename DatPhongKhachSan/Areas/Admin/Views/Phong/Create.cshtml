@model DatPhongKhachSan.Models.ViewModels.PhongFormViewModel
@{ ViewData["Title"] = "Thêm phòng"; }
<div class="container py-4" style="max-width:600px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Phòng</a></li><li class="breadcrumb-item active">Thêm</li></ol>
    </nav>
    <h2 class="fw-bold mb-4">Thêm phòng mới</h2>
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <partial name="_PhongForm" model="Model" />
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
