@model List<DatPhongKhachSan.Models.Entities.Phong>
@{
    ViewData["Title"] = "Quản lý phòng";
    var badges = new Dictionary<string,string> { ["Trong"]="success",["DangO"]="primary",["DangDonDep"]="warning" };
    var labels = new Dictionary<string,string> { ["Trong"]="Trống",["DangO"]="Đang ở",["DangDonDep"]="Đang dọn" };
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="fw-bold mb-0"><i class="fas fa-door-open me-2 text-primary"></i>Phòng</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Thêm phòng</a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <!-- ── Mobile cards ──────────────────────────────────── -->
            <div class="d-md-none p-2 d-flex flex-column gap-2">
                @foreach (var p in Model)
                {
                    var badge = badges.GetValueOrDefault(p.TrangThai, "secondary");
                    var label = labels.GetValueOrDefault(p.TrangThai, p.TrangThai);
                    <div class="card border rounded-3 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center gap-3">
                                <!-- Số phòng -->
                                <div class="rounded-3 d-flex align-items-center justify-content-center fw-bold text-white"
                                     style="width:52px;height:52px;flex-shrink:0;font-size:1.1rem;background:linear-gradient(135deg,#6366f1,#8b5cf6);">
                                    @p.SoPhong
                                </div>
                                <!-- Thông tin -->
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@p.MaLoaiPhongNavigation?.TenLoaiPhong</div>
                                    <div class="text-muted small">@(p.Tang.HasValue ? $"Tầng {p.Tang}" : "Chưa có tầng")</div>
                                    <div class="mt-1">
                                        <span class="badge bg-@badge">@label</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(p.GhiChu))
                                    {
                                        <div class="text-muted small mt-1 text-truncate">@p.GhiChu</div>
                                    }
                                </div>
                                <!-- Nút -->
                                <div class="d-flex flex-column gap-1" style="flex-shrink:0;">
                                    @if (p.TrangThai != "DangO")
                                    {
                                        <a asp-action="Edit" asp-route-id="@p.MaPhong" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@p.MaPhong" method="post"
                                              data-confirm="Xóa phòng @p.SoPhong?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Đang có<br/>khách</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.Any()) { <div class="text-center text-muted py-4 small">Chưa có phòng nào.</div> }
            </div>

            <!-- ── Desktop table ──────────────────────────────────── -->
            <div class="table-responsive d-none d-md-block">
            <table id="tbl" class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr><th>Số phòng</th><th>Tầng</th><th>Loại phòng</th><th>Trạng thái</th><th>Ghi chú</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var badge = badges.GetValueOrDefault(p.TrangThai, "secondary");
                        var label = labels.GetValueOrDefault(p.TrangThai, p.TrangThai);
                        <tr>
                            <td class="fw-bold">@p.SoPhong</td>
                            <td>@(p.Tang.HasValue ? $"Tầng {p.Tang}" : "-")</td>
                            <td>@p.MaLoaiPhongNavigation?.TenLoaiPhong</td>
                            <td><span class="badge bg-@badge">@label</span></td>
                            <td class="text-muted small">@p.GhiChu</td>
                            <td class="text-end">
                                @if (p.TrangThai != "DangO")
                                {
                                    <a asp-action="Edit" asp-route-id="@p.MaPhong" class="btn btn-outline-primary btn-sm me-1"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@p.MaPhong" method="post" class="d-inline"
                                          data-confirm="Xóa phòng @p.SoPhong?">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-trash"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Đang có khách</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script>
        $('#tbl').DataTable({ language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/vi.json' } });
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title:'Xác nhận xóa', text:f.dataset.confirm, icon:'warning',
                    showCancelButton:true, confirmButtonText:'Xóa', cancelButtonText:'Hủy',
                    confirmButtonColor:'#dc3545' }).then(r => { if(r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
