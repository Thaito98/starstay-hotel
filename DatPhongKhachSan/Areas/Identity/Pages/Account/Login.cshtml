@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<style>
    .auth-bg { background: linear-gradient(135deg,#e0f2fe 0%,#dde6ff 100%); min-height: calc(100vh - 72px); display:flex; align-items:center; justify-content:center; padding:40px 16px; }
    .auth-card { background:#fff; border-radius:20px; box-shadow:0 8px 40px rgba(99,102,241,.14); padding:44px 40px; width:100%; max-width:440px; }
    .auth-logo { text-align:center; margin-bottom:28px; }
    .auth-logo-icon { font-size:2.4rem; color:#6366f1; margin-bottom:6px; }
    .auth-logo-name { font-size:1.4rem; font-weight:900; color:#0f172a; }
    .auth-logo-sub { font-size:.76rem; color:#94a3b8; letter-spacing:.04em; }
    .auth-title { font-size:1.3rem; font-weight:800; color:#0f172a; text-align:center; margin-bottom:4px; }
    .auth-sub { font-size:.85rem; color:#64748b; text-align:center; margin-bottom:28px; }
    .auth-card .form-control { border-radius:10px; font-size:.95rem; border-color:#e2e8f0; }
    .auth-card .form-control:focus { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,.12); }
    .auth-card .form-label { font-weight:600; font-size:.875rem; color:#374151; }
    .password-toggle { margin-top:8px; }
    .password-toggle .form-check-label { color:#64748b; cursor:pointer; }
    .btn-auth { background:linear-gradient(135deg,#0ea5e9,#6366f1); border:0; border-radius:11px; font-weight:700; letter-spacing:.02em; padding:12px; }
    .btn-auth:hover { opacity:.9; transform:translateY(-1px); }
    .auth-divider { text-align:center; color:#94a3b8; font-size:.8rem; margin:18px 0 14px; }
    @@media (max-width:480px) { .auth-card { padding:32px 20px; } }
</style>

<div class="auth-bg">
    <div class="auth-card">
        <div class="auth-logo">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <div class="auth-logo-icon"><i class="fas fa-hotel"></i></div>
                <div class="auth-logo-name">StarStay Hotel</div>
                <div class="auth-logo-sub">Đà Nẵng &bull; 4 sao</div>
            </a>
        </div>

        <h2 class="auth-title">Chào mừng trở lại!</h2>
        <p class="auth-sub">Đăng nhập để quản lý đặt phòng của bạn</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 small mb-3" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i>@Model.ErrorMessage
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

        <form id="account" method="post">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control form-control-lg"
                       autocomplete="username" placeholder="your@email.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="Input.Password" class="form-label mb-0">Mật khẩu</label>
                    <a asp-page="./ForgotPassword" class="small text-decoration-none" style="color:#6366f1">Quên mật khẩu?</a>
                </div>
                <input asp-for="Input.Password" class="form-control form-control-lg"
                       autocomplete="current-password" placeholder="••••••••" />
                <div class="form-check password-toggle">
                    <input class="form-check-input" type="checkbox" id="show-password" />
                    <label class="form-check-label small" for="show-password">Hiển thị mật khẩu</label>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label small" asp-for="Input.RememberMe">Ghi nhớ đăng nhập</label>
            </div>
            <button id="login-submit" type="submit" class="btn btn-primary btn-auth w-100 btn-lg mb-3">
                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
            </button>
        </form>

        <div class="text-center">
            <span class="text-muted small">Chưa có tài khoản?</span>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"
               class="fw-semibold ms-1 text-decoration-none" style="color:#6366f1">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('show-password')?.addEventListener('change', function () {
            const passwordInput = document.getElementById('Input_Password');
            if (passwordInput) {
                passwordInput.type = this.checked ? 'text' : 'password';
            }
        });
    </script>
}
