@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="mb-1"><i class="fas fa-user-circle me-2 text-primary"></i>Hồ sơ cá nhân</h3>
<p class="text-muted small mb-4">Cập nhật thông tin cá nhân của bạn</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">Email (không thể thay đổi)</label>
            <input value="@Model.Username" class="form-control" disabled />
        </div>
        <div class="col-12">
            <label asp-for="Input.HoTen" class="form-label">Họ và tên *</label>
            <input asp-for="Input.HoTen" class="form-control" placeholder="Nguyễn Văn A" />
            <span asp-validation-for="Input.HoTen" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.SoDienThoai" class="form-label">Số điện thoại</label>
            <input asp-for="Input.SoDienThoai" class="form-control" placeholder="0912 345 678" />
            <span asp-validation-for="Input.SoDienThoai" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Input.CCCD" class="form-label">CCCD / Hộ chiếu</label>
            <input asp-for="Input.CCCD" class="form-control" placeholder="012345678901" />
            <span asp-validation-for="Input.CCCD" class="text-danger small"></span>
        </div>
    </div>

    <div class="mt-4">
        <button id="update-profile-button" type="submit" class="btn btn-primary btn-save">
            <i class="fas fa-save me-2"></i>Lưu thay đổi
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
