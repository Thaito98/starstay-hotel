@section Scripts {
<script>
(function () {
    var track = document.getElementById('roomsTrack');
    if (!track) return;

    var slides   = Array.from(track.children);
    var total    = slides.length;
    var current  = 0;
    var autoTimer;
    var prevBtn  = document.getElementById('roomPrev');
    var nextBtn  = document.getElementById('roomNext');
    var dotsWrap = document.getElementById('roomDots');

    function getVisible() {
        var w = window.innerWidth;
        if (w >= 992) return Math.min(3, total);
        if (w >= 576) return Math.min(2, total);
        return 1;
    }

    function maxIdx() { return Math.max(0, total - getVisible()); }

    function goTo(idx) {
        var vis    = getVisible();
        current    = Math.max(0, Math.min(idx, maxIdx()));
        var gap    = 20;
        var vpW    = track.parentElement.offsetWidth;
        var slideW = (vpW - gap * (vis - 1)) / vis;
        track.style.transform = 'translateX(-' + (current * (slideW + gap)) + 'px)';
        dotsWrap.querySelectorAll('.carousel-dot').forEach(function(d, i) {
            d.classList.toggle('active', i === current);
        });
        prevBtn.disabled = current === 0;
        nextBtn.disabled = current >= maxIdx();
    }

    function buildDots() {
        dotsWrap.innerHTML = '';
        for (var i = 0; i <= maxIdx(); i++) {
            var d = document.createElement('button');
            d.className = 'carousel-dot' + (i === 0 ? ' active' : '');
            d.setAttribute('aria-label', 'Trang ' + (i + 1));
            (function(idx) {
                d.addEventListener('click', function() { goTo(idx); resetAuto(); });
            })(i);
            dotsWrap.appendChild(d);
        }
    }

    function resetAuto() {
        clearInterval(autoTimer);
        autoTimer = setInterval(function() {
            goTo(current >= maxIdx() ? 0 : current + 1);
        }, 4500);
    }

    prevBtn.addEventListener('click', function() { goTo(current - 1); resetAuto(); });
    nextBtn.addEventListener('click', function() { goTo(current + 1); resetAuto(); });

    track.parentElement.addEventListener('mouseenter', function() { clearInterval(autoTimer); });
    track.parentElement.addEventListener('mouseleave', resetAuto);

    var touchStartX = 0;
    track.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
    }, { passive: true });
    track.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) { goTo(dx < 0 ? current + 1 : current - 1); resetAuto(); }
    }, { passive: true });

    var resizeTimer;
    window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() { buildDots(); goTo(Math.min(current, maxIdx())); }, 150);
    });

    buildDots();
    goTo(0);
    resetAuto();
})();
</script>
}
