@model DatPhongKhachSan.Models.ViewModels.ChiTietDonViewModel
@{
    ViewData["Title"] = $"Đơn {Model.Don.MaDon}";
    var don = Model.Don;
    var trangThaiText = don.TrangThai switch
    {
        "ChoXacNhan"  => ("Chờ xác nhận",  "warning"),
        "DaXacNhan"   => ("Đã xác nhận",   "primary"),
        "DangO"       => ("Đang ở",        "success"),
        "DaTraPhong"  => ("Đã trả phòng",  "secondary"),
        "ChoHoanTien" => ("Chờ hoàn tiền", "info"),
        "DaHuy"       => ("Đã hủy",        "danger"),
        _             => (don.TrangThai, "secondary")
    };
}

<div class="container py-4" style="max-width:900px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="TraCuuDon">Tra cứu</a></li>
                <li class="breadcrumb-item active">@don.MaDon</li>
            </ol>
        </nav>
        <span class="badge bg-@trangThaiText.Item2 fs-6">@trangThaiText.Item1</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3">
        <!-- Thông tin đơn + khách -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-file-alt me-1 text-primary"></i>Thông tin đơn
                </div>
                <div class="card-body small">
                    <div class="row g-1">
                        <div class="col-5 text-muted">Mã đơn</div>
                        <div class="col-7 fw-bold">@don.MaDon</div>

                        <div class="col-5 text-muted">Nguồn đặt</div>
                        <div class="col-7">
                            <span class="badge @(don.NguonDat == "WalkIn" ? "bg-info" : "bg-primary")">
                                @don.NguonDat
                            </span>
                        </div>

                        <div class="col-5 text-muted">Ngày đặt</div>
                        <div class="col-7">@don.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>

                        @if (don.TrangThai == "ChoHoanTien" && don.NgayHuy.HasValue)
                        {
                            <div class="col-5 text-muted">Ngày hủy</div>
                            <div class="col-7 text-danger fw-semibold">@don.NgayHuy.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        }

                        <div class="col-5 text-muted">Nhận phòng</div>
                        <div class="col-7 fw-semibold text-success">@don.NgayNhanPhong.ToString("dd/MM/yyyy")</div>

                        <div class="col-5 text-muted">Trả phòng</div>
                        <div class="col-7 fw-semibold text-danger">@don.NgayTraPhong.ToString("dd/MM/yyyy")</div>

                        <div class="col-5 text-muted">Số đêm</div>
                        <div class="col-7">@don.SoDem đêm</div>

                        <div class="col-5 text-muted">Số người</div>
                        <div class="col-7">@don.TongSoNguoiLon NL@(don.TongSoTreEm > 0 ? $", {don.TongSoTreEm} TE" : "")</div>

                        @if (!string.IsNullOrEmpty(don.GhiChu))
                        {
                            <div class="col-5 text-muted">Ghi chú</div>
                            <div class="col-7 text-muted" style="white-space:pre-wrap;">@don.GhiChu</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-user me-1 text-primary"></i>Thông tin khách
                </div>
                <div class="card-body small">
                    <div class="row g-1">
                        <div class="col-5 text-muted">Họ tên</div>
                        <div class="col-7 fw-semibold">@Model.KhachHang.HoTen</div>

                        <div class="col-5 text-muted">SĐT</div>
                        <div class="col-7">@(Model.KhachHang.SoDienThoai ?? "-")</div>

                        <div class="col-5 text-muted">CCCD</div>
                        <div class="col-7">@(Model.KhachHang.CCCD ?? "-")</div>

                        <div class="col-5 text-muted">Email</div>
                        <div class="col-7">@(Model.KhachHang.Email ?? "-")</div>

                        <div class="col-5 text-muted">Phân loại</div>
                        <div class="col-7">@Model.KhachHang.PhanLoai</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết phòng -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-bed me-1 text-primary"></i>Chi tiết phòng
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Phòng</th><th>Loại phòng</th><th>Khách lưu trú</th>
                                <th class="text-end">Giá/đêm</th><th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTiets)
                            {
                                <tr>
                                    <td><b>@ct.MaPhongNavigation?.SoPhong</b></td>
                                    <td>@ct.MaPhongNavigation?.MaLoaiPhongNavigation?.TenLoaiPhong</td>
                                    <td>@ct.TenKhachLuuTru</td>
                                    <td class="text-end">@ct.GiaMotDem.ToString("N0") ₫</td>
                                    <td class="text-end">@((ct.GiaMotDem * Model.SoDem).ToString("N0")) ₫</td>
                                </tr>
                                @foreach (var dv in ct.ChiTietDichVus)
                                {
                                    <tr class="table-light text-muted small">
                                        <td colspan="2" class="ps-4">
                                            <i class="fas fa-concierge-bell me-1"></i>@dv.MaDichVuNavigation?.TenDichVu
                                        </td>
                                        <td>x@dv.SoLuong</td>
                                        <td class="text-end">@dv.DonGia.ToString("N0") ₫</td>
                                        <td class="text-end">@((dv.ThanhTien ?? 0).ToString("N0")) ₫</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="fw-bold">
                            <tr>
                                <td colspan="4" class="text-end">Tổng cộng</td>
                                <td class="text-end text-primary">@Model.TongTien.ToString("N0") ₫</td>
                            </tr>
                            <tr class="text-success">
                                <td colspan="4" class="text-end">Đã thanh toán</td>
                                <td class="text-end">@Model.DaTra.ToString("N0") ₫</td>
                            </tr>
                            @if (Model.ConLai > 0)
                            {
                                <tr class="text-warning">
                                    <td colspan="4" class="text-end">Còn lại</td>
                                    <td class="text-end">@Model.ConLai.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Lịch sử thanh toán -->
        @if (don.ThanhToans.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light fw-semibold">
                        <i class="fas fa-receipt me-1 text-primary"></i>Lịch sử thanh toán
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <thead class="table-light">
                                <tr><th>Loại</th><th>Phương thức</th><th>Mã GD</th><th>Trạng thái</th><th class="text-end">Số tiền</th><th>Ngày</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var tt in don.ThanhToans.OrderBy(t => t.NgayTao))
                                {
                                    <tr>
                                        <td>@tt.LoaiThanhToan</td>
                                        <td>@tt.PhuongThuc</td>
                                        <td class="text-muted small">@(tt.MaGiaoDich ?? "-")</td>
                                        <td>
                                            <span class="badge bg-@(tt.TrangThai == "ThanhCong" ? "success" : tt.TrangThai == "ThatBai" ? "danger" : "warning")">
                                                @tt.TrangThai
                                            </span>
                                        </td>
                                        <td class="text-end fw-semibold">@tt.SoTien.ToString("N0") ₫</td>
                                        <td class="small text-muted">@tt.NgayTao.ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Nút thao tác theo trạng thái -->
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-action="TraCuuDon" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>

        @if (don.TrangThai == "ChoXacNhan")
        {
            <form asp-action="XacNhanDon" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDatPhong" value="@don.MaDatPhong" />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-check me-1"></i>Xác nhận đơn
                </button>
            </form>
            <a asp-action="ChuyenPhong" asp-route-id="@don.MaDatPhong" class="btn btn-outline-info">
                <i class="fas fa-exchange-alt me-1"></i>Đổi phòng
            </a>
        }

        @if (don.TrangThai == "DaXacNhan")
        {
            <a asp-action="CheckIn" asp-route-id="@don.MaDatPhong" class="btn btn-success">
                <i class="fas fa-sign-in-alt me-1"></i>Check-in
            </a>
            <a asp-action="ChuyenPhong" asp-route-id="@don.MaDatPhong" class="btn btn-outline-info">
                <i class="fas fa-exchange-alt me-1"></i>Đổi phòng
            </a>
        }

        @if (don.TrangThai == "DangO")
        {
            <form asp-action="CheckOut" method="post" class="d-inline"
                  data-confirm="Xác nhận check-out đơn @don.MaDon?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maDatPhong" value="@don.MaDatPhong" />
                <button type="submit" class="btn btn-warning text-dark">
                    <i class="fas fa-sign-out-alt me-1"></i>Check-out
                </button>
            </form>
            <a asp-action="ChuyenPhong" asp-route-id="@don.MaDatPhong" class="btn btn-info text-dark">
                <i class="fas fa-exchange-alt me-1"></i>Chuyển phòng
            </a>
            <a asp-action="GiaHan" asp-route-id="@don.MaDatPhong" class="btn btn-outline-primary">
                <i class="fas fa-calendar-plus me-1"></i>Gia hạn
            </a>
        }

    </div>

    <!-- Thông tin hoàn tiền (chỉ xem - lễ tân tư vấn khách) -->
    @if ((don.TrangThai == "ChoHoanTien" || don.TrangThai == "DaHuy") && ViewBag.TiLeHoan != null)
    {
        int tileHoan    = (int)ViewBag.TiLeHoan;
        decimal soTienH = (decimal)ViewBag.SoTienHoan;
        string alertCls = tileHoan == 100 ? "success" : tileHoan == 50 ? "warning" : "secondary";
        <div class="alert alert-@alertCls mt-3 d-flex align-items-center gap-2">
            <i class="fas fa-undo-alt"></i>
            <div>
                <span class="fw-semibold">Chính sách hoàn tiền:</span>
                hoàn <b>@tileHoan%</b>
                @if (soTienH > 0)
                {
                    <span> = <b>@soTienH.ToString("N0") ₫</b></span>
                }
                else
                {
                    <span class="text-muted"> (hủy sát ngày nhận phòng - không hoàn)</span>
                }
                @if (don.NgayHuy.HasValue)
                {
                    <span class="text-muted ms-2 small">(hủy lúc @don.NgayHuy.Value.ToString("dd/MM/yyyy HH:mm"))</span>
                }
                <br/><span class="text-muted small">Việc chuyển khoản hoàn tiền do quản lý xử lý qua app ngân hàng.</span>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-confirm]').forEach(f => {
            f.addEventListener('submit', e => {
                e.preventDefault();
                Swal.fire({ title: 'Xác nhận', text: f.dataset.confirm, icon: 'question',
                    showCancelButton: true, confirmButtonText: 'Đồng ý', cancelButtonText: 'Hủy',
                    confirmButtonColor: '#198754'
                }).then(r => { if (r.isConfirmed) f.submit(); });
            });
        });
    </script>
}
