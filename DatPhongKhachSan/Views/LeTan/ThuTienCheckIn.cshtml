@model DatPhongKhachSan.Models.ViewModels.ThuTienCheckInViewModel
@{
    ViewData["Title"] = "Thu tiền trước check-in";
}

<div class="container py-4" style="max-width:540px;">
    <h3 class="fw-bold mb-4"><i class="fas fa-money-bill-wave me-2 text-warning"></i>Thu tiền trước check-in</h3>

    <div class="alert alert-warning">
        <i class="fas fa-info-circle me-2"></i>
        Đơn <b>@Model.MaDon</b> đặt cọc 30% - cần thu thêm
        <b>@Model.SoTienConLai.ToString("N0") ₫</b> trước khi check-in.
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="ThuTienCheckIn" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaDatPhong" />
                <input type="hidden" asp-for="MaDon" />
                <input type="hidden" asp-for="SoTienConLai" />

                <div class="mb-3">
                    <label asp-for="SoTienThu" class="form-label fw-semibold">
                        Số tiền thu <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input name="SoTienThu" id="SoTienThu" type="number"
                               class="form-control" step="1"
                               value="@((long)Math.Round(Model.SoTienThu))" />
                        <span class="input-group-text">₫</span>
                    </div>
                    <span asp-validation-for="SoTienThu" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhuongThuc" class="form-label fw-semibold">Phương thức</label>
                    <select asp-for="PhuongThuc" class="form-select">
                        <option value="TienMat">Tiền mặt</option>
                        <option value="ChuyenKhoan">Chuyển khoản</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                    <input asp-for="GhiChu" class="form-control" placeholder="Tuỳ chọn..." />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check me-1"></i>Thu tiền & Check-in
                    </button>
                    <a asp-action="ChiTietDon" asp-route-id="@Model.MaDatPhong"
                       class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
