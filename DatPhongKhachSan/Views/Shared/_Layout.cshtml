<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StarStay Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { padding-top: 62px; }
        .navbar-brand { font-weight: 800; letter-spacing: .4px; font-size: 1.1rem; }
        .room-card { transition: transform .2s, box-shadow .2s; }
        .room-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,.12) !important; }
        /* ── Chat button ─────────────────────────────────────── */
        #chat-btn {
            position: fixed; bottom: 24px; right: 24px; z-index: 1050;
            width: 52px; height: 52px; border-radius: 50%;
            background: #0d6efd; color: #fff; border: none;
            font-size: 22px; box-shadow: 0 4px 12px rgba(13,110,253,.4);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: transform .2s, background .2s;
        }
        #chat-btn:hover { transform: scale(1.1); }

        /* ── Chat window ─────────────────────────────────────── */
        #chat-window {
            position: fixed; bottom: 88px; right: 24px; z-index: 1049;
            width: 360px; height: 520px;
            background: #fff; border-radius: 16px;
            box-shadow: 0 8px 36px rgba(0,0,0,.22);
            display: flex; flex-direction: column; overflow: hidden;
            animation: chatIn .2s ease;
        }
        @@keyframes chatIn {
            from { opacity: 0; transform: translateY(14px) scale(.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        #chat-header {
            background: linear-gradient(135deg,#0d6efd,#6610f2);
            color: #fff; padding: 12px 14px;
            display: flex; align-items: center; gap: 10px;
            flex-shrink: 0;
        }
        #chat-header .chat-avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: rgba(255,255,255,.2);
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; flex-shrink: 0;
        }
        #chat-header .chat-title { flex: 1; }
        #chat-header .chat-title strong { display: block; font-size: .92rem; }
        #chat-header .chat-title small { font-size: .75rem; opacity: .8; }
        #chat-header .chat-hdr-btns { display: flex; gap: 4px; }
        #chat-header .chat-hdr-btns button {
            background: rgba(255,255,255,.15); border: none; color: #fff;
            width: 28px; height: 28px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; cursor: pointer; transition: background .15s;
        }
        #chat-header .chat-hdr-btns button:hover { background: rgba(255,255,255,.3); }
        #chat-msgs {
            flex: 1; overflow-y: auto; padding: 12px;
            display: flex; flex-direction: column; gap: 8px;
            background: #f3f4f6;
        }
        #chat-msgs::-webkit-scrollbar { width: 4px; }
        #chat-msgs::-webkit-scrollbar-track { background: transparent; }
        #chat-msgs::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
        .chat-msg { max-width: 84%; font-size: .875rem; line-height: 1.55; word-break: break-word; }
        .chat-msg-user {
            align-self: flex-end;
            background: #0d6efd; color: #fff;
            padding: 8px 13px; border-radius: 16px 16px 4px 16px;
        }
        .chat-msg-bot {
            align-self: flex-start;
            display: flex; align-items: flex-start; gap: 7px;
        }
        .chat-bot-icon {
            width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
            background: #e9ecef; display: flex; align-items: center; justify-content: center;
            font-size: 12px; color: #0d6efd; margin-top: 1px;
        }
        .chat-bot-text {
            background: #fff; color: #212529;
            padding: 8px 13px; border-radius: 16px 16px 16px 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
        }
        /* Typing dots */
        .typing-dot {
            display: inline-block; width: 6px; height: 6px;
            background: #adb5bd; border-radius: 50%; margin: 0 2px;
            animation: typeBounce .9s infinite;
        }
        .typing-dot:nth-child(2) { animation-delay: .18s; }
        .typing-dot:nth-child(3) { animation-delay: .36s; }
        @@keyframes typeBounce {
            0%,60%,100% { transform: translateY(0); }
            30% { transform: translateY(-5px); }
        }
        /* Quick-reply chips */
        .chat-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 0; }
        .chat-chip {
            font-size: .78rem; padding: 4px 10px;
            border: 1px solid #0d6efd; border-radius: 20px;
            background: #fff; color: #0d6efd; cursor: pointer;
            transition: background .15s, color .15s;
        }
        .chat-chip:hover { background: #0d6efd; color: #fff; }
        /* Footer input */
        #chat-footer {
            padding: 10px 12px; border-top: 1px solid #e9ecef;
            display: flex; gap: 8px; align-items: center;
            flex-shrink: 0; background: #fff;
        }
        #chat-input {
            flex: 1; border: 1px solid #dee2e6; border-radius: 20px;
            padding: 8px 14px; font-size: .875rem; outline: none;
            transition: border-color .15s; resize: none;
        }
        #chat-input:focus { border-color: #0d6efd; box-shadow: 0 0 0 2px rgba(13,110,253,.12); }
        #chat-send {
            background: #0d6efd; color: #fff; border: none;
            border-radius: 50%; width: 38px; height: 38px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: background .15s;
        }
        #chat-send:hover:not(:disabled) { background: #0b5ed7; }
        #chat-send:disabled { background: #adb5bd; cursor: not-allowed; }
        @@media (max-width: 576px) {
            #chat-window {
                width: calc(100vw - 16px);
                height: calc(100dvh - 100px);
                right: 8px; left: 8px;
                bottom: 80px; border-radius: 12px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark fixed-top shadow-sm"
             style="background:#0c1f3a;border-bottom:1px solid rgba(255,255,255,.07)">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="display:inline-flex;align-items:center;gap:8px">
                        <span style="width:28px;height:28px;border-radius:7px;background:linear-gradient(135deg,#0ea5e9,#6366f1);display:inline-flex;align-items:center;justify-content:center;font-size:13px">
                            <i class="fas fa-hotel"></i>
                        </span>
                        StarStay Hotel
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Phong" asp-action="Index">
                                <i class="fas fa-door-open me-1"></i>Phòng
                            </a>
                        </li>

                        @if (User.IsInRole("KhachHang"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="DatPhong" asp-action="LichSu">
                                    <i class="fas fa-history me-1"></i>Đơn của tôi
                                </a>
                            </li>
                        }

                        @{
                            bool hasLeTan = User.HasClaim("ChucNang", "TraCuuDon") ||
                                            User.HasClaim("ChucNang", "CheckInOut") ||
                                            User.HasClaim("ChucNang", "DatWalkIn") ||
                                            User.HasClaim("ChucNang", "ChuyenGiaHan");
                            bool hasBuong = User.HasClaim("ChucNang", "BuongPhong");
                        }
                        @if (hasLeTan || hasBuong)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-tools me-1"></i>Vận hành
                                </a>
                                <ul class="dropdown-menu">
                                    @if (hasLeTan)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="LeTan" asp-action="TraCuuDon">
                                                <i class="fas fa-concierge-bell me-2"></i>Tra cứu đơn
                                            </a>
                                        </li>
                                    }
                                    @if (hasBuong)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="BuongPhong" asp-action="Index">
                                                <i class="fas fa-broom me-2"></i>Buồng phòng
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (User.HasClaim("ChucNang", "XepCa") || User.HasClaim("ChucNang", "ChamCong") ||
                             User.HasClaim("ChucNang", "QuanLyDanhMuc") || User.HasClaim("ChucNang", "QuanLyDon") ||
                             User.HasClaim("ChucNang", "QuanLyNguoiDung") || User.HasClaim("ChucNang", "GanQuyen"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog me-1"></i>Quản trị
                                </a>
                                <ul class="dropdown-menu">
                                    @if (User.HasClaim("ChucNang","XepCa") || User.HasClaim("ChucNang","ChamCong"))
                                    {
                                        <li><h6 class="dropdown-header small">Nhân sự</h6></li>
                                        @if (User.HasClaim("ChucNang","XepCa"))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="PhanCa" asp-action="Index"><i class="fas fa-calendar-alt me-2"></i>Xếp ca</a></li>
                                        }
                                        @if (User.HasClaim("ChucNang","ChamCong"))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="ChamCong" asp-action="Index"><i class="fas fa-user-clock me-2"></i>Chấm công</a></li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    @if (User.HasClaim("ChucNang","QuanLyDon") || User.HasClaim("ChucNang","QuanLyNguoiDung") || User.HasClaim("ChucNang","GanQuyen"))
                                    {
                                        <li><h6 class="dropdown-header small">Quản lý</h6></li>
                                        @if (User.HasClaim("ChucNang","QuanLyDon"))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="DonDatPhong" asp-action="Index"><i class="fas fa-file-invoice me-2"></i>Tất cả đơn</a></li>
                                        }
                                        @if (User.HasClaim("ChucNang","QuanLyNguoiDung"))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="NguoiDung" asp-action="Index"><i class="fas fa-users me-2"></i>Người dùng</a></li>
                                        }
                                        @if (User.HasClaim("ChucNang","GanQuyen"))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="PhanQuyen" asp-action="Index"><i class="fas fa-shield-alt me-2"></i>Gán quyền</a></li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    @if (User.HasClaim("ChucNang","QuanLyChatbot"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Chatbot" asp-action="Index"><i class="fas fa-robot me-2"></i>Chatbot FAQ</a></li>
                                    }
                                    @if (User.HasClaim("ChucNang","XemBaoCao"))
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="BaoCao" asp-action="Index"><i class="fas fa-chart-bar me-2"></i>Báo cáo doanh thu</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    @if (User.HasClaim("ChucNang","QuanLyDanhMuc"))
                                    {
                                        <li><h6 class="dropdown-header small">Danh mục</h6></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="LoaiPhong" asp-action="Index"><i class="fas fa-bed me-2"></i>Loại phòng</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Phong" asp-action="Index"><i class="fas fa-door-open me-2"></i>Phòng</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="TienNghi" asp-action="Index"><i class="fas fa-star me-2"></i>Tiện nghi</a></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="DichVu" asp-action="Index"><i class="fas fa-spa me-2"></i>Dịch vụ</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer style="background:#0c1f3a;color:rgba(255,255,255,.7)">
        <div class="container py-5">
            <div class="row g-4">
                <!-- Brand -->
                <div class="col-md-4 col-lg-3">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div style="width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,#0ea5e9,#6366f1);display:flex;align-items:center;justify-content:center">
                            <i class="fas fa-hotel text-white" style="font-size:16px"></i>
                        </div>
                        <span style="font-size:1.1rem;font-weight:800;color:#fff">StarStay Hotel</span>
                    </div>
                    <p style="font-size:.84rem;line-height:1.7;max-width:220px">
                        Khách sạn 4 sao bên bờ biển Đà Nẵng - nơi sang trọng gặp sự bình yên.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" style="width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:14px;transition:background .15s" class="text-decoration-none footer-social-icon">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" style="width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:14px" class="text-decoration-none">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" style="width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.6);font-size:14px" class="text-decoration-none">
                            <i class="fab fa-tiktok"></i>
                        </a>
                    </div>
                </div>

                <!-- Khám phá -->
                <div class="col-6 col-md-2 col-lg-2 offset-lg-1">
                    <p style="font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin-bottom:14px">Khám phá</p>
                    <a href="/Phong" class="d-block text-decoration-none mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65);transition:color .15s">Tất cả phòng</a>
                    <a href="/" class="d-block text-decoration-none mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Trang chủ</a>
                    <a href="/DatPhong" class="d-block text-decoration-none mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Đặt phòng</a>
                </div>

                <!-- Dịch vụ -->
                <div class="col-6 col-md-2 col-lg-2">
                    <p style="font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin-bottom:14px">Dịch vụ</p>
                    <span class="d-block mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Hồ bơi</span>
                    <span class="d-block mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Nhà hàng</span>
                    <span class="d-block mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Spa & Massage</span>
                    <span class="d-block mb-2" style="font-size:.84rem;color:rgba(255,255,255,.65)">Đưa đón sân bay</span>
                </div>

                <!-- Liên hệ -->
                <div class="col-md-4 col-lg-3">
                    <p style="font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;margin-bottom:14px">Liên hệ</p>
                    <div class="d-flex gap-2 mb-2 align-items-start">
                        <i class="fas fa-map-marker-alt mt-1" style="color:#0ea5e9;width:14px;font-size:.8rem"></i>
                        <span style="font-size:.84rem">123 Võ Nguyên Giáp, Mỹ An, Ngũ Hành Sơn, Đà Nẵng</span>
                    </div>
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <i class="fas fa-phone" style="color:#0ea5e9;width:14px;font-size:.8rem"></i>
                        <a href="tel:02361234567" class="text-decoration-none" style="font-size:.84rem;color:rgba(255,255,255,.65)">0236 123 4567</a>
                    </div>
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <i class="fas fa-envelope" style="color:#0ea5e9;width:14px;font-size:.8rem"></i>
                        <a href="mailto:info@starstay.vn" class="text-decoration-none" style="font-size:.84rem;color:rgba(255,255,255,.65)">info@starstay.vn</a>
                    </div>
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <i class="fas fa-clock" style="color:#0ea5e9;width:14px;font-size:.8rem"></i>
                        <span style="font-size:.84rem">Lễ tân: 24/7</span>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <i class="fas fa-door-open" style="color:#0ea5e9;width:14px;font-size:.8rem"></i>
                        <span style="font-size:.84rem">Nhận phòng 14:00 · Trả phòng 12:00</span>
                    </div>
                </div>
            </div>
        </div>
        <div style="border-top:1px solid rgba(255,255,255,.08)">
            <div class="container py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span style="font-size:.78rem;color:rgba(255,255,255,.35)">&copy; @DateTime.Now.Year StarStay Hotel. All rights reserved.</span>
                <span style="font-size:.78rem;color:rgba(255,255,255,.35)">
                    <i class="fas fa-lock me-1"></i>Thanh toán bảo mật qua VNPay
                </span>
            </div>
        </div>
    </footer>

    <!-- ── Chat window ───────────────────────────────────────────────────── -->
    <div id="chat-window" style="display:none"
         data-logged-in="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">

        <div id="chat-header">
            <div class="chat-avatar"><i class="fas fa-robot"></i></div>
            <div class="chat-title">
                <strong>StarStay AI</strong>
                <small>Trợ lý ảo &bull; Trả lời tự động</small>
            </div>
            <div class="chat-hdr-btns">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button id="chat-delete" title="Xóa lịch sử chat">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                }
                <button id="chat-close" title="Đóng">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <div id="chat-msgs"></div>

        <div id="chat-footer">
            <input id="chat-input" type="text"
                   placeholder="Nhập câu hỏi của bạn..." autocomplete="off"
                   maxlength="500" />
            <button id="chat-send" title="Gửi">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <button id="chat-btn" title="Hỗ trợ trực tuyến">
        <i class="fas fa-comments"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
