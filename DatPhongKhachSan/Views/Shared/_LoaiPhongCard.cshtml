@model DatPhongKhachSan.Models.ViewModels.LoaiPhongCardViewModel

<div class="col">
    <div class="card h-100 shadow-sm border-0 room-card">
        <!-- Ảnh -->
        <div class="room-img-wrapper position-relative" style="height:200px;overflow:hidden;">
            @if (!string.IsNullOrEmpty(Model.AnhChinh))
            {
                <img src="@Model.AnhChinh" class="card-img-top w-100 h-100" style="object-fit:cover;" alt="@Model.TenLoaiPhong" />
            }
            else
            {
                <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-secondary bg-opacity-10">
                    <i class="fas fa-bed fa-3x text-secondary opacity-50"></i>
                </div>
            }
            @if (Model.SoPhongConTrong > 0)
            {
                <span class="badge bg-success position-absolute top-0 end-0 m-2">
                    Còn phòng
                </span>
            }
            else
            {
                <span class="badge bg-danger position-absolute top-0 end-0 m-2">Hết phòng</span>
            }
        </div>

        <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">@Model.TenLoaiPhong</h5>

            <!-- Thông tin cơ bản -->
            <div class="d-flex gap-3 text-muted small mb-2">
                @if (Model.DienTich.HasValue)
                {
                    <span><i class="fas fa-ruler-combined me-1"></i>@Model.DienTich m²</span>
                }
                <span><i class="fas fa-user me-1"></i>@Model.SucChuaNguoiLon NL</span>
                @if (!string.IsNullOrEmpty(Model.LoaiGiuong))
                {
                    <span><i class="fas fa-bed me-1"></i>@Model.LoaiGiuong</span>
                }
            </div>

            <!-- Tiện nghi (tối đa 4) -->
            @if (Model.TenTienNghis.Any())
            {
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @for (int i = 0; i < Math.Min(4, Model.TenTienNghis.Count); i++)
                    {
                        <span class="badge bg-light text-dark border small">
                            <i class="fas @Model.BieuTuongTienNghis[i] me-1 text-primary"></i>@Model.TenTienNghis[i]
                        </span>
                    }
                    @if (Model.TenTienNghis.Count > 4)
                    {
                        <span class="badge bg-light text-muted border small">+@(Model.TenTienNghis.Count - 4)</span>
                    }
                </div>
            }

            <div class="mt-auto">
                <div class="d-flex align-items-end justify-content-between">
                    <div>
                        <span class="text-muted small">Từ</span>
                        <div class="fw-bold text-primary fs-5">@Model.GiaCoBan.ToString("N0") ₫</div>
                        <span class="text-muted small">/đêm</span>
                    </div>
                    <a asp-controller="Phong" asp-action="ChiTiet" asp-route-id="@Model.MaLoaiPhong"
                       class="btn btn-outline-primary btn-sm">
                        Xem chi tiết <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
