@using Microsoft.AspNetCore.Identity
@using DatPhongKhachSan.Areas.Identity.Data
@inject SignInManager<DatPhongKhachSanUser> SignInManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
            <i class="fas fa-user-circle me-1"></i>@User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              method="post">
            <button type="submit" class="nav-link btn btn-link">
                <i class="fas fa-sign-out-alt me-1"></i>Đăng xuất
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus me-1"></i>Đăng ký
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
        </a>
    </li>
}
</ul>
