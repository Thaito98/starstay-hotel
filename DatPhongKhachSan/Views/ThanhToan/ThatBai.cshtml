@{
    ViewData["Title"] = "Thanh toán thất bại";
    var maDon = ViewBag.MaDon as string;
    var msg   = ViewBag.Msg as string;
    var code  = ViewBag.ResponseCode as string;
}

<div class="container py-5" style="max-width:540px;">
    <div class="card border-0 shadow text-center">
        <div class="card-body p-5">
            <div class="mb-3">
                <i class="fas fa-times-circle fa-5x text-danger"></i>
            </div>
            <h2 class="fw-bold text-danger mb-1">Thanh toán thất bại</h2>
            <p class="text-muted mb-3">
                @if (!string.IsNullOrEmpty(msg))
                {
                    @msg
                }
                else
                {
                    <span>Giao dịch không thành công. Đơn hàng đã bị hủy.</span>
                }
                @if (!string.IsNullOrEmpty(code))
                {
                    <span class="text-muted small d-block">Mã lỗi: @code</span>
                }
            </p>

            @if (!string.IsNullOrEmpty(maDon))
            {
                <p class="text-muted small">Mã đơn: <b>@maDon</b></p>
            }

            <div class="d-flex gap-2 justify-content-center mt-3">
                <a asp-controller="Phong" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-redo me-1"></i>Thử đặt lại
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-home me-1"></i>Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
